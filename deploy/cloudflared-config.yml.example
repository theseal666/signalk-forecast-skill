# Copy to ~/.cloudflared/config.yml and fill in your own tunnel ID
# (from `cloudflared tunnel create forecast-skill`) and hostname.
tunnel: YOUR-TUNNEL-ID-HERE
credentials-file: /home/YOUR-USER/.cloudflared/YOUR-TUNNEL-ID-HERE.json

ingress:
  - hostname: forecast.yourdomain.example
    service: http://localhost:8080
  - service: http_status:404
